<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#0B0C0F"
    android:padding="16dp">

    <com.chahu.app.ui.ParkingMapView
        android:id="@+id/map"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:layout_marginStart="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tagline"
                android:textColor="#C8C8D0"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/feature"
                android:textColor="#7FB8FF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lotName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#9A9AA2"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/timeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <SeekBar
                android:id="@+id/timeSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/duration"
                android:textColor="#9A9AA2"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/durationGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/d1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1시간" android:textColor="#FFFFFF" />
                <RadioButton android:id="@+id/d2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2시간" android:textColor="#FFFFFF" android:checked="true" />
                <RadioButton android:id="@+id/d3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3시간" android:textColor="#FFFFFF" />
            </RadioGroup>

            <Button
                android:id="@+id/askButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:text="@string/ask"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/resultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <Button
                android:id="@+id/departButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/depart" />

            <TextView
                android:id="@+id/logText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#8A8A92"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
